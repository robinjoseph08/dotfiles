if [[ $OSTYPE == darwin* ]]; then
  alias ls="ls -G"
fi
alias gl="git log"
alias gs="git status"
alias ga="git add"
alias gc="git commit"
alias gp="git push"
alias gch="git checkout"
alias gf="git fetch"
alias gr="git rebase"
alias gb="git branch"
alias k='kubectl "--context=${KUBECTL_CONTEXT:-$(kubectl config current-context)}" ${KUBECTL_NAMESPACE/[[:alnum:]-]*/--namespace=${KUBECTL_NAMESPACE}}'

alias pia="pi --model openai-codex/gpt-6-astra"
alias pis="pi --model openai-codex/gpt-6.1-sol"
alias pil="pi --model openai-codex/gpt-6-luna"

alias ccfh="claude --allow-dangerously-skip-permissions --model claude-fable-5-1 --effort high"
alias ccfm="claude --allow-dangerously-skip-permissions --model claude-fable-5-1 --effort medium"
alias ccf="ccfh"
alias ccoh="claude --allow-dangerously-skip-permissions --model claude-opus-5-5 --effort high"
alias ccom="claude --allow-dangerously-skip-permissions --model claude-opus-5-5 --effort medium"
alias cco="ccoh"
alias cc="ccoh"
